@base <http://www.semanticweb.org/praji/ontologies/2026/9/untitled-ontology-2/> .

<https://w3id.org/FAIR-course-UT/2026/group22/ont> rdf:type owl:Ontology ;
                                                    owl:imports <http://www.opengis.net/ont/geosparql#1.1> .

#################################################################
#    Data properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group22/ont#waterBodyType
:waterBodyType rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :WaterBody ;
               rdfs:range xsd:string ;
               rdfs:comment "Classification of a water body, such as lake, lagoon, reservoir, river, or abandoned meander, based on the original IBGE dataset."@en ;
               rdfs:label "Water body type"@en .


###  https://w3id.org/FAIR-course-UT/2026/group22/ont#waterRegime
:waterRegime rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :WaterBody ;
             rdfs:range xsd:string ;
             rdfs:comment "Indicates whether a water body is permanent or temporary, based on the regime attribute in the original IBGE dataset."@en ;
             rdfs:label "Water regime"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group22/ont#WaterBody
:WaterBody rdf:type owl:Class ;
           rdfs:label "Water Body"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :WaterBody ;
   owl:annotatedProperty rdfs:label ;
   owl:annotatedTarget "Water Body"@en ;
   rdfs:comment "A geographic water body represented in the IBGE BC250 hydrography dataset."@en
 ] .


